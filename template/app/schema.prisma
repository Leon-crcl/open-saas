datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  email                     String?         @unique
  username                  String?         @unique
  isAdmin                   Boolean         @default(false)

  paymentProcessorUserId    String?         @unique
  lemonSqueezyCustomerPortalUrl String?     // You can delete this if you're not using Lemon Squeezy as your payments processor.
  subscriptionStatus        String?         // 'active', 'cancel_at_period_end', 'past_due', 'deleted'
  subscriptionPlan          String?         // 'hobby', 'pro'
  datePaid                  DateTime?
  credits                   Int             @default(3)

  contactFormMessages       ContactFormMessage[]
  suppliers                 Supplier[]
  supplierSettings          SupplierSettings?
  files                     File[]
}

model ProcessedWebhookEvent {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  paymentProcessorEventId   String          @unique // The payment processor's event id, e.g. `evt_...` for Stripe.
  eventType                 String                  // The payment processor's event type, e.g. `invoice.paid`.
}

model Supplier {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  user                      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                    String

  name                      String
  category                  String?
  country                   String?
  notes                     String?

  price                     Float                   // Price per unit, in the account currency (SupplierSettings.currency).
  quality                   Int                     // 0-100, higher is better.
  deliveryDays              Int                     // Delivery time in days, lower is better.
  risk                      Int                     // 0-100, lower is better.

  @@index([userId])
}

model SupplierSettings {
  id                        String          @id @default(uuid())
  updatedAt                 DateTime        @updatedAt

  user                      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                    String          @unique

  currency                  String          @default("EUR")

  // Scoring weights as whole numbers from 0 to 100. They are normalized when scoring,
  // so they do not need to add up to 100.
  weightPrice               Int             @default(35)
  weightQuality             Int             @default(30)
  weightDelivery            Int             @default(20)
  weightRisk                Int             @default(15)
}

model File {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  name                      String
  type                      String
  s3Key                     String
}

model DailyStats {
  id                               Int             @id @default(autoincrement())
  date                             DateTime        @default(now()) @unique

  totalViews                       Int             @default(0)
  prevDayViewsChangePercent        String          @default("0")
  userCount                        Int             @default(0)
  paidUserCount                    Int             @default(0)
  userDelta                        Int             @default(0)
  paidUserDelta                    Int             @default(0)
  totalRevenue                     Float           @default(0)
  totalProfit                      Float           @default(0)

  sources                          PageViewSource[]
}

model PageViewSource {
  @@id([date, name])
  name                     String
  date                     DateTime        @default(now())

  dailyStats               DailyStats?     @relation(fields: [dailyStatsId], references: [id])
  dailyStatsId             Int?

  visitors                 Int
}

model Logs {
  id                       Int             @id @default(autoincrement())
  createdAt                DateTime        @default(now())

  message                  String
  level                    String
}

model ContactFormMessage {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  content                   String
  isRead                    Boolean         @default(false)
  repliedAt                 DateTime?
}
